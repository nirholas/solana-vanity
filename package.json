{
  "name": "solana-vanity",
  "version": "1.0.0",
  "description": "Open-source Solana vanity address generator: WebAssembly Ed25519 grinding in the browser, an exact Base58 difficulty model, signed proof-of-grind certificates, trustless split-key delegation, an HTTP API, a CLI and an MCP server.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "nirholas <support@three.ws>",
  "homepage": "https://github.com/nirholas/solana-vanity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/solana-vanity.git"
  },
  "bugs": {
    "url": "https://github.com/nirholas/solana-vanity/issues"
  },
  "keywords": [
    "solana",
    "vanity",
    "vanity-address",
    "vanity-wallet",
    "address-generator",
    "keypair",
    "ed25519",
    "base58",
    "wasm",
    "webassembly",
    "split-key",
    "proof-of-grind",
    "mcp",
    "agent",
    "web3"
  ],
  "bin": {
    "solana-vanity": "cli/solana-vanity.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./grinder": "./src/grinder-node.js",
    "./rarity": "./src/rarity.js",
    "./split-key": "./src/split-key.js",
    "./proof-of-grind": "./src/proof-of-grind.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cli",
    "mcp",
    "server",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node --watch server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.js",
    "mcp": "node mcp/index.js",
    "keygen": "node server/keygen.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "deploy:cf": "npm run build && npx wrangler deploy",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name solana-vanity"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^1.8.0",
    "@solana/web3.js": "^3.0.2",
    "bs58": "^6.0.0",
    "hono": "^4.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "three": "^0.184.0",
    "vite": "^7.3.0",
    "wrangler": "^4.40.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
